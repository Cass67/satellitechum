SATELLITECHUM_ENV=production
SECRET_KEY=replace-with-a-random-64-char-hex-string
SESSION_COOKIE_SECURE=true
TRUSTED_HOSTS=satellitechum.example.com
SATELLITECHUM_RATE_LIMIT_WINDOW_SECONDS=60
SATELLITECHUM_RATE_LIMIT_SEARCH=30
SATELLITECHUM_RATE_LIMIT_LOCATION_INTEL=20
SATELLITECHUM_RATE_LIMIT_SATELLITE_DETAILS=30
TUNNEL_TOKEN=
# REDIS_URL is set automatically by compose.yml; override here only if using an external Redis
# REDIS_URL=redis://redis:6379/0
