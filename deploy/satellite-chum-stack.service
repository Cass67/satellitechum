[Unit]
Description=Satellite Chum Podman Compose Stack
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=%h/satellite-chum
ExecStart=/home/cass/.local/bin/podman-compose -f compose.yml up -d
ExecStop=/home/cass/.local/bin/podman-compose -f compose.yml down

[Install]
WantedBy=default.target
